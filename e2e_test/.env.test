# E2E 전용 더미 환경변수 — 실제 시크릿이 아니며 CI가 사용한다.
# 이 값이 노출돼도 무해해야 한다. 실제 키를 여기에 넣지 말 것.

# SES로 이메일을 실제로 보내지 않겠다는 것이다.
SPRING_PROFILES_ACTIVE=local

# Postgres 컨테이너 초기화용 — app이 아니라 postgres 서비스가 읽는다
POSTGRES_DB=runiverse_e2e
POSTGRES_USER=runiverse
POSTGRES_PASSWORD=runiverse

# CORS 설정
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# 데이터베이스 설정 — compose 네트워크 안에서는 서비스 이름이 곧 호스트명이다
DATABASE_URL=jdbc:postgresql://postgres:5432/runiverse_e2e
DATABASE_USERNAME=runiverse
DATABASE_PASSWORD=runiverse

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# JPA 설정 — 빈 DB에 스키마를 만들어야 하므로 배포용 validate가 아니다
# 기존의 테스트 서버에서의 update가 아닌 create-drop을 이용해서 전부 지우고 다시 시작 개념으로 간다
JPA_DDL=create-drop
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_OPEN_IN_VIEW=false

# 타임존 설정 — TimeZoneConfig가 기본값 없이 요구해서 비우면 컨텍스트가 죽는다
APP_TIME_ZONE=Asia/Seoul

# JWT 설정 — JwtSecretKeyFactory가 32바이트 미만이면 기동에 실패한다
JWT_ACCESS_SECRET=e2e-access-token-secret-for-ci-only-not-a-real-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=e2e-refresh-token-secret-for-ci-only-not-a-real-key
JWT_REFRESH_TTL=7d

# Kakao OAuth 설정 — E2E에서 실제로 호출하지 않는다
KAKAO_REST_API_KEY=e2e-client-id
KAKAO_CLIENT_SECRET=e2e-client-secret
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao

# Google OAuth 설정
GOOGLE_CLIENT_ID=e2e-client-id
GOOGLE_CLIENT_SECRET=e2e-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# AWS SES 설정 — local 프로필이라 쓰이지 않지만 SesProperties가 @NotBlank라 비우면 컨텍스트가 죽는다
SES_REGION=ap-northeast-2
SES_FROM_ADDRESS=no-reply@runiverse.test

# AWS S3 설정 — 더 이상 더미가 아니다. localstack이 이 이름으로 버킷을 만든다
# (docker-compose.yml의 E2E_*_BUCKET·네트워크 별칭과 값이 같아야 한다)
S3_REGION=ap-northeast-2
S3_USER_ASSET_BUCKET=runiverse-e2e-user-asset
S3_GPS_TRACK_BUCKET=runiverse-e2e-gps-track

# S3를 localstack으로 돌린다 — AWS SDK가 직접 읽는 표준 환경변수라
# 앱 코드나 프로퍼티를 고치지 않고 엔드포인트만 갈아끼울 수 있다.
# 키는 localstack이 검증하지 않지만, 비우면 DefaultCredentialsProvider가
# EC2 메타데이터까지 뒤지다 실패해 presigned URL 발급조차 못 한다
AWS_ENDPOINT_URL_S3=http://localstack:4566
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=e2e
AWS_SECRET_ACCESS_KEY=e2e
