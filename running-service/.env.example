# CORS 설정
# 허용할 Origin/Method/Header 목록 — 쉼표(,)로 구분
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=

# 데이터베이스 설정
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Redis 설정
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# JPA 설정
# JPA_DDL: validate | update | create | create-drop
JPA_DDL=
JPA_SHOW_SQL=
JPA_FORMAT_SQL=
JPA_OPEN_IN_VIEW=

# JWT 설정
# SECRET: 32Byte 이상 랜덤 문자열 / TTL: Duration 형식 (예: 60s, 15m, 7d)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=

# Kakao OAuth 설정
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Google OAuth 설정
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AWS SES 설정
SES_REGION=
SES_FROM_ADDRESS=
# AWS SES 테스트용 키
SES_TEST_ACCESS_KEY_ID=
SES_TEST_SECRET_ACCESS_KEY=

# Google OAuth 설정
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
